# normalize line endings in the repo; check out with the platform's endings
* text=auto

# C# aware diffs (shows the enclosing method in hunk headers)
*.cs diff=csharp

# shell scripts must keep LF to run
*.sh text eol=lf

# binary assets: never touch line endings or try to diff
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.bin binary
